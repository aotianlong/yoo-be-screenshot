{
  "manifest_version": 3,
  "name": "Yoo Screenshot",
  "short_name": "Yoo截图",
  "version": "1.0.0",
  "description": "截取可视区域、整页或选中区域，可选附加当前页面 URL",
  "permissions": ["activeTab", "scripting", "tabs", "downloads"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Yoo Screenshot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
