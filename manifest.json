{
  "manifest_version": 3,
  "name": "Yoo Screenshot",
  "short_name": "Yoo截图",
  "version": "1.0.0",
  "description": "截取可视/整页/选区，本地编辑后保存；可选在图片底部附加页面 URL",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Yoo Screenshot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
